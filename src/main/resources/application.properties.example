# 配置模板：复制本文件为 application-local.properties 并填入自己的真实值，
# 该副本已被 .gitignore 忽略，不会提交到仓库。
#
# 也可以不用本文件，改用环境变量注入（优先级更高）：
#   DB_USERNAME / DB_PASSWORD / JWT_SECRET
#
# JWT 密钥建议至少 32 字节，生成方式：openssl rand -base64 48

spring.datasource.username=root
spring.datasource.password=your-mysql-password
jwt.secret=replace-with-a-random-secret-at-least-32-bytes-long
